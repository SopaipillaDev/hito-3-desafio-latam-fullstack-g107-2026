    {
      "id": "nota",
      "type": "text",
      "x": 100,
      "y": 520,
      "width": 700,
      "height": 100,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
